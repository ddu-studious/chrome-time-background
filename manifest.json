{
  "manifest_version": 3,
  "minimum_chrome_version": "142",
  "name": "中国风景时钟",
  "version": "3.16.0",
  "description": "中国风景新标签页时钟，支持天气、备忘录、独立音乐播放器、哔哩哔哩集成(关注分组/UP主主页/已购课程/倍速画质控制/Cookie共享)、温情提示、扩展活动监控、热搜资讯、书签智能检索，含性能省电模式",
  "permissions": [
    "storage",
    "sidePanel",
    "tabGroups",
    "favicon",
    "identity",
    "unlimitedStorage",
    "geolocation",
    "tabs",
    "alarms",
    "notifications",
    "downloads",
    "scripting",
    "webNavigation",
    "cookies",
    "offscreen",
    "system.cpu",
    "system.memory",
    "system.storage",
    "contextMenus",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "oauth2": {
    "client_id": "1007025986012-gsr45foqj45aueagb35osdi3hqmp38lg.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.readonly"
    ]
  },
  "optional_permissions": [
    "bookmarks"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://*.unsplash.com/*",
    "https://api.unsplash.com/*",
    "https://api.pexels.com/*",
    "https://pixabay.com/*",
    "https://www.bing.com/*",
    "https://wallhaven.cc/*",
    "https://api.coverr.co/*",
    "https://api.nasa.gov/*",
    "https://devapi.qweather.com/*",
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*",
    "https://api.github.com/*",
    "https://hacker-news.firebaseio.com/*",
    "https://www.reddit.com/*",
    "https://dev.to/*",
    "https://www.meczyc6.info/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "*://music.163.com/*",
    "*://*.music.163.com/*",
    "*://*.bilibili.com/*",
    "*://*.bilivideo.com/*",
    "*://api.bilibili.com/*",
    "*://s.search.bilibili.com/*",
    "*://*.mashibing.com/*",
    "http://127.0.0.1:19840/*",
    "http://localhost:19840/*",
    "http://127.0.0.1:19841/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "site-workspace.html"
  },
  "commands": {
    "open-site-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "打开或关闭网站工作区侧边栏"
    },
    "add-current-tab-to-site-workspace": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "将当前标签加入网站工作区"
    },
    "music-toggle-playback": {
      "suggested_key": "MediaPlayPause",
      "description": "网易云音乐：播放或暂停；尚未播放时启动私人 FM"
    },
    "music-next-track": {
      "suggested_key": "MediaNextTrack",
      "description": "网易云音乐：下一首；尚未播放时启动私人 FM"
    },
    "music-previous-track": {
      "description": "网易云音乐：上一首"
    },
    "music-play-personal-fm": {
      "description": "网易云音乐：播放私人 FM"
    },
    "music-play-daily-recommend": {
      "description": "网易云音乐：播放每日推荐"
    }
  },
  "action": {
    "default_title": "中国风景时钟（左键主页，右键快捷播放与工作区）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://player.bilibili.com/*", "*://www.bilibili.com/video/*", "*://www.bilibili.com/bangumi/*"],
      "js": ["js/bilibili-player-inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://www.mashibing.com/study*"],
      "js": ["js/mashibing-tracker.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  }
}
